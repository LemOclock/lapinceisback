# Copier ce fichier en .env et remplir les valeurs

# Connexion PostgreSQL
PG_URL=postgres://lapince:MOT_DE_PASSE@localhost:5432/lapince

# Secret de signature des tokens (au moins 32 caractères aléatoires)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

PORT=3000

# Nombre de reverse proxies devant l'API (1 en local, 2 en production : Caddy + Nginx)
TRUST_PROXY=1

# Origines autorisées (séparées par des virgules) si le front est servi sur un autre domaine.
# Laisser vide si le front et l'API sont sur le même domaine (reverse proxy /api).
CORS_ORIGIN=

# Cloudinary (facultatif : uniquement pour les images d'opérations)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Afficher les requêtes SQL dans les logs
DB_LOGGING=false
