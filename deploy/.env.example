# Copier en deploy/.env (jamais commité) et remplir.
# Générer chaque secret avec : openssl rand -hex 32

# Mot de passe de la base (hexadécimal : pas de caractères spéciaux dans l'URL de connexion)
POSTGRES_PASSWORD=

# Secret de signature des tokens (64 caractères hex)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Port local sur lequel le Caddy de l'hôte doit pointer (127.0.0.1 uniquement)
WEB_PORT=8090

# Cloudinary (facultatif)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
